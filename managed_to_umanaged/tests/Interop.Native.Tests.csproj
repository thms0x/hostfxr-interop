<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <InteropTargetFramework Condition="'$(InteropTargetFramework)' == ''">net48</InteropTargetFramework>
    <TargetFramework>$(InteropTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <PlatformTarget Condition="'$(TargetFramework)' == 'net48'">x64</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../managed/Interop.Native/Interop.Native.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
