set(INTEROP_TARGET_FRAMEWORK "net48" CACHE STRING "Managed target: net48 (primary, Windows) or net8.0 and newer")
if(INTEROP_TARGET_FRAMEWORK STREQUAL "net48")
    if(NOT WIN32)
        message(FATAL_ERROR "The default .NET Framework 4.8 host requires Windows. For modern .NET on this platform, select -DINTEROP_TARGET_FRAMEWORK=net10.0 (or another installed net8.0+ target).")
    endif()
    if(NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$" OR CMAKE_GENERATOR_PLATFORM MATCHES "^[Aa][Rr][Mm]")
        message(FATAL_ERROR "The .NET Framework 4.8 host requires MSVC and a Windows x64 target (use -A x64).")
    endif()
elseif(NOT INTEROP_TARGET_FRAMEWORK MATCHES "^net([89]|[1-9][0-9]+)\\.0$")
    message(FATAL_ERROR "Unsupported INTEROP_TARGET_FRAMEWORK: use net48 or net8.0 and newer.")
endif()

find_program(DOTNET_EXECUTABLE dotnet REQUIRED)
execute_process(COMMAND "${DOTNET_EXECUTABLE}" --version
    OUTPUT_VARIABLE dotnet_version OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
string(REGEX MATCH "^[0-9]+" dotnet_major "${dotnet_version}")
if(dotnet_major LESS 8)
    message(FATAL_ERROR "A .NET SDK 8 or newer is required")
endif()
if(NOT INTEROP_TARGET_FRAMEWORK STREQUAL "net48")

# An explicit pack path also supports nonstandard SDK installations and cross builds.
set(DOTNET_HOST_PACK "" CACHE PATH "Directory containing nethost.h, hostfxr.h and static nethost")
if(NOT DOTNET_HOST_PACK)
    execute_process(COMMAND "${DOTNET_EXECUTABLE}" --list-sdks
        OUTPUT_VARIABLE dotnet_sdks COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCH "\\[([^\r\n]+)\\]" sdk_match "${dotnet_sdks}")
    get_filename_component(dotnet_root "${CMAKE_MATCH_1}" DIRECTORY)
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
        set(dotnet_arch arm64)
    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
        set(dotnet_arch x64)
    else()
        message(FATAL_ERROR "ABI v1 supports x64 and arm64; set DOTNET_HOST_PACK explicitly if detection failed")
    endif()
    if(WIN32)
        set(dotnet_platform win)
    elseif(APPLE)
        set(dotnet_platform osx)
    else()
        set(dotnet_platform "*")
    endif()
    file(GLOB host_packs "${dotnet_root}/packs/Microsoft.NETCore.App.Host.${dotnet_platform}-${dotnet_arch}/*/runtimes/*/native")
    list(SORT host_packs COMPARE NATURAL ORDER DESCENDING)
    foreach(pack IN LISTS host_packs)
        if(UNIX AND NOT APPLE AND pack MATCHES "/Microsoft.NETCore.App.Host.(win|osx)-")
            continue()
        endif()
        if(EXISTS "${pack}/nethost.h")
            set(DOTNET_HOST_PACK "${pack}" CACHE PATH "Native .NET host pack directory" FORCE)
            break()
        endif()
    endforeach()
endif()
if(NOT EXISTS "${DOTNET_HOST_PACK}/hostfxr.h")
    message(FATAL_ERROR "Cannot find the SDK native host pack; set -DDOTNET_HOST_PACK=/path/to/native")
endif()
if(WIN32)
    set(nethost_static "${DOTNET_HOST_PACK}/libnethost.lib")
else()
    set(nethost_static "${DOTNET_HOST_PACK}/libnethost.a")
endif()
if(NOT EXISTS "${nethost_static}")
    message(FATAL_ERROR "Static nethost library missing: ${nethost_static}")
endif()
add_library(interop_nethost STATIC IMPORTED)
set_target_properties(interop_nethost PROPERTIES IMPORTED_LOCATION "${nethost_static}"
    INTERFACE_INCLUDE_DIRECTORIES "${DOTNET_HOST_PACK}")

endif() # modern .NET host pack

function(interop_managed target project assembly)
    set(output "${CMAKE_CURRENT_BINARY_DIR}/managed/${target}")
    file(GLOB_RECURSE sources CONFIGURE_DEPENDS "${project}/*.cs" "${project}/*.csproj")
    list(FILTER sources EXCLUDE REGEX "/(bin|obj)/")
    add_custom_command(OUTPUT "${output}/${assembly}.dll"
        COMMAND "${DOTNET_EXECUTABLE}" build "${project}/${assembly}.csproj"
            --configuration Release --output "${output}"
            --artifacts-path "${CMAKE_CURRENT_BINARY_DIR}/dotnet"
            "-p:InteropTargetFramework=${INTEROP_TARGET_FRAMEWORK}"
            -p:NuGetAudit=false -p:RestoreIgnoreFailedSources=true --nologo
        DEPENDS ${sources} ${ARGN} VERBATIM)
    add_custom_target(${target} ALL DEPENDS "${output}/${assembly}.dll")
    set(${target}_DIR "${output}" PARENT_SCOPE)
endfunction()
